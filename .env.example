# Copie para .env (que NUNCA vai para o git) e ajuste. Todos os valores tem padrao no codigo.

# Ciclos do orquestrador: 0 = continuo (ate Ctrl+C / docker stop); N = executa N ciclos e encerra
AGROSMART_CICLOS=0
# Segundos entre o fim de um ciclo e o inicio do proximo
AGROSMART_INTERVALO_S=30
# 1 = recria a serie simulada de sensores (seed 42) a cada ciclo
AGROSMART_GERAR_DADOS=0
# Retentativas por etapa, timeout por etapa (s) e limite de falhas seguidas antes de parar
AGROSMART_RETENTATIVAS=1
AGROSMART_TIMEOUT_ETAPA_S=120
AGROSMART_MAX_FALHAS_CONSECUTIVAS=5
# Nivel do log no console: DEBUG | INFO | WARNING | ERROR (o arquivo .jsonl sempre guarda DEBUG)
AGROSMART_NIVEL_LOG=INFO
# Modelo de agendamento usado no event_log (process mining)
AGROSMART_INTERVALO_AGENDAMENTO_MIN=30
AGROSMART_DEFASAGEM_AGENDAMENTO_S=0

# Linux: uid/gid do seu usuario para gravar em ./evidencias_docker (Windows/Mac: deixe o padrao)
AGROSMART_UID=10001
AGROSMART_GID=10001

# Opcional, so para 3_IA_Generativa_Apoio_Decisao/gerar_relatorio_ia.py (fora do pipeline).
# Sem a chave, o modulo usa o modo simulado. Nunca commite a chave.
ANTHROPIC_API_KEY=
